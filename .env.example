# AutoKol 环境变量配置示例
# 复制为 .env 后填入实际值

# 访问密码（设置后需密码登录，不设置则无登录保护）
APP_PASSWORD=

# 硅基流动 LLM
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# Gmail SMTP（二选一）
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SendGrid API（二选一）
SENDGRID_API_KEY=
SENDGRID_SENDER=

# 云端同步
PROGRESS_API_KEY=

# 错误监控（可选）
SENTRY_DSN=
